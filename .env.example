# Any LiteLLM model string, e.g. anthropic/claude-sonnet-4-5, openai/gpt-4o-mini, ollama/qwen2.5:7b
AUDITRL_MODEL=anthropic/claude-sonnet-4-5
AUDITRL_TEMPERATURE=0
AUDITRL_DATA_DIR=./var
AUDITRL_DB_URL=

# Provider keys (only the one matching AUDITRL_MODEL is needed)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# For local models served by Ollama / vLLM
OLLAMA_API_BASE=http://localhost:11434

# Phase 2 benchmark
# SEC asks for a contact in the User-Agent: "Your Name you@example.com"
AUDITRL_SEC_USER_AGENT=
# Model that writes the research reports being audited (temperature > 0 for natural variety)
AUDITRL_AGENT_MODEL=anthropic/claude-sonnet-4-5
AUDITRL_AGENT_TEMPERATURE=0.7

# Phase 3 judge (optional). When set, the judge rules on each claim instead of the verifiers.
# For a fine-tuned adapter served by `modal deploy`: AUDITRL_JUDGE_MODEL=openai/judge-<run name>
# and AUDITRL_JUDGE_API_BASE=https://<workspace>--auditrl-judge-serve.modal.run/v1
AUDITRL_JUDGE_MODEL=
AUDITRL_JUDGE_API_BASE=
AUDITRL_JUDGE_API_KEY=
